 int
 enet_socket_bind (ENetSocket socket, const ENetAddress * address)
 {
+#if defined(_PSP) || defined(__psp__)
+    // PSP/PPSSPP: must bind to INADDR_ANY, not a specific local IP
+    struct sockaddr_in sin4;
+    memset(&sin4, 0, sizeof(sin4));
+    sin4.sin_family = AF_INET;
+    sin4.sin_addr.s_addr = INADDR_ANY;
+    // Preserve the port from the address if set
+    if (address->address.ss_family == AF_INET) {
+        sin4.sin_port = ((struct sockaddr_in*)&address->address)->sin_port;
+    }
+    return bind (socket, (struct sockaddr *)&sin4, sizeof(sin4));
+#else
     return bind (socket,
         (struct sockaddr *) & address -> address,
         address -> addressLength);
+#endif
 }
 
